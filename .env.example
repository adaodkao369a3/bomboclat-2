# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
PREFIX=.

# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database

# Klipy GIF API
# SECURITY NOTE: If you have used this key before the security fix (v1.0+), rotate it immediately
# as the old key was exposed in plaintext logs. The fix prevents future logging of the key.
KLIPY_KEY=your_klipy_api_key_here
KLIPY_URL=https://api.klipy.com/v2/search

# AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
HF_API_TOKEN=your_hugging_face_api_token_here

# Channel IDs
WELCOME_CHANNEL_ID=
SHOP_CHANNEL_ID=
